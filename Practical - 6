#include <iostream>
#include <fcntl.h>
#include <unistd.h>

using namespace std;

int main()
{
    char source[100], destination[100];
    char buffer[1024];
    int sourceFile, destinationFile;
    int bytesRead;

    cout << "Enter source file name: ";
    cin >> source;

    cout << "Enter destination file name: ";
    cin >> destination;

    // Open source file
    sourceFile = open(source, O_RDONLY);

    if (sourceFile == -1)
    {
        cout << "Error: Cannot open source file." << endl;
        return 1;
    }

    // Create destination file
    destinationFile = open(destination, O_WRONLY | O_CREAT | O_TRUNC, 0644);

    if (destinationFile == -1)
    {
        cout << "Error: Cannot create destination file." << endl;
        close(sourceFile);
        return 1;
    }

    // Copy file contents
    while ((bytesRead = read(sourceFile, buffer, sizeof(buffer))) > 0)
    {
        write(destinationFile, buffer, bytesRead);
    }

    // Close files
    close(sourceFile);
    close(destinationFile);

    cout << "File copied successfully!" << endl;

    return 0;
}
