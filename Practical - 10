            cout << "Not Allocated";

        cout << endl;
    }
}

int main()
{
    int m, n;

    cout << "Enter number of memory blocks: ";
    cin >> m;

    int block[m];

    cout << "Enter size of memory blocks:\n";
    for (int i = 0; i < m; i++)
    {
        cout << "Block " << i + 1 << ": ";
        cin >> block[i];
    }

    cout << "\nEnter number of processes: ";
    cin >> n;

    int process[n];

    cout << "Enter size of processes:\n";
    for (int i = 0; i < n; i++)
    {
        cout << "Process " << i + 1 << ": ";
        cin >> process[i];
    }

    firstFit(block, m, process, n);
    bestFit(block, m, process, n);
    worstFit(block, m, process, n);

    return 0;
}
